# Copy to .secrets and `make run`. Never commit .secrets.
OPAL_SIGNING_SECRET=<generated when creating the Custom Connector app in Opal>
PORT=8080

# Production: the dedicated 1Password admin identity.
OP_ACCOUNT_ADDRESS=example.1password.com
OP_EMAIL=opal-connector@example.com
OP_SECRET_KEY=A3-XXXXXX-...
OP_PASSWORD=...
OP_CONFIG_DIR=./op-config

# Local only: leave OP_PASSWORD unset to use the 1Password desktop app integration instead,
# optionally picking an account by sign-in address, email, or UUID:
# OP_ACCOUNT=my.1password.com
